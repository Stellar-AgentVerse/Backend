# Entorno de ejecución.
# Los adapters de pago simulados y el JWT_SECRET por defecto SOLO se permiten
# con NODE_ENV=development o NODE_ENV=test. Cualquier otro valor — incluido
# staging, production o dejarlo sin definir — hace que la aplicación no arranque
# si algún flag de simulación está activo o si falta JWT_SECRET.
NODE_ENV=development

# Base de datos PostgreSQL
PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=agentverse
# Migrations own the schema. Docker Compose interpolates this same file, so
# leaving it true would auto-synchronize on top of a migrated database.
# Run `npm run migration:run` before starting outside Docker.
DB_SYNCHRONIZE=false
# Container entrypoint applies migrations before starting
RUN_MIGRATIONS_ON_START=true
DB_LOGGING=false
DB_SEED_ON_STARTUP=true

# Configuración general
JWT_SECRET=change-me-in-local-dev
JWT_EXPIRES_IN=24h
CORS_ORIGINS=http://localhost:3000,http://localhost:4200

# Configuración de Stripe
STRIPE_API_KEY=sk_test_tu_api_key_aqui

# Configuración de PayPal
PAYPAL_CLIENT_ID=tu_client_id_aqui
PAYPAL_CLIENT_SECRET=tu_client_secret_aqui
PAYPAL_ENV=sandbox

# Configuración de Stellar / Soroban
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
# ID de tus contratos desplegados
SOROBAN_TOKEN_MINT_CONTRACT_ID=
SOROBAN_TOKEN_SALE_CONTRACT_ID=
SOROBAN_MARKETPLACE_CONTRACT_ID=
# Clave privada del admin
STELLAR_ADMIN_SECRET_KEY=

# Simulación de pagos (solo development/test)
# Ningún adapter de pago tiene integración real: Stripe y PayPal fabrican sus
# respuestas. Estos flags deben quedar en false fuera de development y test;
# validateEnv rechaza el arranque si están activos.
PAYMENT_SIMULATION_ENABLED=false
MOCK_PAYMENT_ENABLED=false
MOCK_PAYMENT_FAIL=false

# AWS / KMS
AWS_REGION=us-east-1
AWS_KMS_KEY_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# S3-compatible encrypted prompt storage (MinIO defaults for Docker Compose)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=agentverse-prompts
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# 32-byte base64 key. Generate with: openssl rand -base64 32
PROMPT_CONTENT_ENCRYPTION_KEY=
